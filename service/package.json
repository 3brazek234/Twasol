{
  "name": "service",
  "version": "1.0.0",
  "description": "Court-based lawyer job marketplace with real-time chat and salary negotiation",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --target ES2022 --module commonjs --moduleResolution node --esModuleInterop --strict --skipLibCheck prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "test:unit": "vitest run tests/unit -c vitest.unit.config.ts",
    "test:integration": "vitest run tests/integration --pool=forks --poolOptions.forks.singleFork",
    "test:watch": "jest --watch",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@aws-sdk/client-s3": "^3.1108.0",
    "@aws-sdk/s3-request-presigner": "^3.1108.0",
    "@bull-board/api": "^8.6.1",
    "@bull-board/express": "^8.6.1",
    "@prisma/client": "^6.8.0",
    "@sentry/node": "^10.70.0",
    "@sentry/profiling-node": "^10.75.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^6.1.0",
    "cloudinary": "^2.11.0",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "expo-server-sdk": "^7.2.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^11.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "prisma": "^6.8.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.5",
    "vitest-mock-extended": "^2.0.2"
  }
}
