# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ─────────────────────────────────────────────────
# When using PgBouncer for connection pooling, append ?pgbouncer=true&connection_limit=5
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lawyer_marketplace?connection_limit=5


# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-too
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Cloudflare R2 (Storage) ──────────────────────────────────
# Presigning credentials MUST be scoped ONLY to GetObject/PutObject for this bucket
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=lawyer_marketplace_docs
R2_PUBLIC_URL= # (Optional, leave blank if bucket is private)

# ── Observability ────────────────────────────────────────────
SENTRY_DSN= # https://your_sentry_dsn
